# -------------------------------------------------------------
# HUNAR BHARAT KA (हुनर भारत का) - Production Environment Variables
# -------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=development

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production MongoDB Atlas:
# Replace <username>, <password>, <cluster-url> and <database_name>
# Example: MONGODB_ATLAS_URL="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/hunar_bharat_ka?retryWrites=true&w=majority"
MONGODB_ATLAS_URL=""

# Production PostgreSQL (Alternative Production SQL):
# Example: POSTGRES_URL="postgresql://user:password@localhost:5432/hunar_bharat_ka?schema=public"
POSTGRES_URL=""

# -------------------------------------------------------------
# Authentication & Cryptography
# -------------------------------------------------------------
JWT_SECRET="hunar_bharat_ka_jwt_secret_key_production_2026"
JWT_EXPIRES_IN="7d"

# -------------------------------------------------------------
# Official WhatsApp Business Platform (Meta Cloud API v19.0)
# -------------------------------------------------------------
# Get these from Meta for Developers -> WhatsApp -> API Setup:
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# -------------------------------------------------------------
# Frontend URL (used in WhatsApp job alert message links)
# -------------------------------------------------------------
# Set this to your deployed frontend domain (Vercel, Netlify, etc.)
FRONTEND_URL="https://hunarbharatka.vercel.app"

# -------------------------------------------------------------
# SMS OTP Gateway Configuration (Optional Production Integration)
# -------------------------------------------------------------
# In development: outputs 6-digit OTP code to server console and API response.
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID=""

# -------------------------------------------------------------
# Cloudinary / Persistent Object Media Storage (Optional)
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
